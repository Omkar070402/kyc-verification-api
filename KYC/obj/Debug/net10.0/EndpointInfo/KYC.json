{
  "openapi": "3.0.4",
  "info": {
    "title": "KYC",
    "version": "1.0"
  },
  "paths": {
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Kyc/verify": {
      "post": {
        "tags": [
          "Kyc"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KYCVerficationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/KYCVerficationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/KYCVerficationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Kyc/status/{id}": {
      "get": {
        "tags": [
          "Kyc"
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Kyc/history/{userId}": {
      "get": {
        "tags": [
          "Kyc"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "KYCVerficationRequest": {
        "type": "object",
        "properties": {
          "idDocumentBase64": {
            "type": "string",
            "nullable": true
          },
          "idDocumentType": {
            "type": "string",
            "nullable": true
          },
          "addressDocumentType": {
            "type": "string",
            "nullable": true
          },
          "addrrssDocumentType": {
            "type": "string",
            "nullable": true
          }
